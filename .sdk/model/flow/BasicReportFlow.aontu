# BasicReportFlow

main: kit: flow: BasicReportFlow:
{
  entity: "report",
  kind: "basic",
  name: "BasicReportFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "report_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "report_ref01",
        srcdatavar: "report_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "report01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-report_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicReportFlow"
}